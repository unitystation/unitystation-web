{
    "name": "unitystation.org",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "oxlint",
        "format": "oxfmt --write",
        "format:check": "oxfmt --check",
        "prepare": "husky",
        "cypress": "cypress open",
        "cypress:headless:e2e": "cypress run --spec \"cypress/e2e/**/*.cy.ts\"",
        "cypress:headless:unit": "cypress run --component",
        "test:e2e": "start-server-and-test dev 3000  cypress:headless:e2e",
        "test:unit": "npm run cypress:headless:unit"
    },
    "dependencies": {
        "@types/ua-parser-js": "^0.7.39",
        "@vercel/analytics": "^1.6.1",
        "classnames": "^2.5.1",
        "jose": "^5.10.0",
        "next": "^16.3.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-icons": "^5.0.1",
        "ua-parser-js": "^2.0.7",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.0",
        "@commitlint/config-conventional": "^21.2.0",
        "@types/node": "^20.19.26",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "autoprefixer": "^10.4.22",
        "babel-plugin-react-compiler": "^1.0.0",
        "cypress": "^15.16.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "oxfmt": "0.58.0",
        "oxlint": "1.73.0",
        "postcss": "^8.5.23",
        "start-server-and-test": "^2.1.3",
        "tailwindcss": "^3.4.18",
        "typescript": "^5.9.3"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,cjs,mjs}": [
            "oxlint --fix",
            "oxfmt --write"
        ],
        "*.{json,jsonc}": [
            "oxfmt --write"
        ]
    }
}
